# ===========================================
# Portal Unificado — Configuração de Ambiente
# ===========================================

# --- Database (MySQL 8.0+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=intranet_db
DB_USER=root
DB_PASS=

# --- LDAP / Active Directory ---
LDAP_ENABLED=false
LDAP_HOST=ldap://ad.empresa.local
LDAP_PORT=389
LDAP_BASE_DN=dc=empresa,dc=com,dc=br
LDAP_BIND_DN=cn=svc-intranet,ou=Service Accounts,dc=empresa,dc=com,dc=br
LDAP_BIND_PASS=
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_DEFAULT_GROUP=Colaboradores

# --- SSO / OAuth2 / OpenID Connect (Azure AD / Keycloak / Google) ---
SSO_ENABLED=false
SSO_PROVIDER=azure-ad
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
SSO_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
SSO_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
SSO_SCOPES=openid profile email
SSO_DEFAULT_GROUP=Colaboradores
SSO_BUTTON_LABEL="Entrar com SSO Corporativo"

# --- Aplicação ---
APP_NAME="Portal Unificado"
APP_ENV=development
APP_URL=http://localhost:8080
APP_SECRET=change-me-to-a-secure-random-string-in-production
SESSION_LIFETIME=7200

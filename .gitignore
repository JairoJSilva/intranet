# .gitignore — Intranet Flowti

# Ambiente
aplicação/.env.local
*.env.backup

# Dependências PHP & Cache de Testes
aplicação/vendor/
aplicação/.phpunit.cache/

# Docker volumes
mysql_data/

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporários
*.tmp
*.bak

# Senhas & Credenciais Sensíveis
senhas-padrão

# Uploads & Favicons Baixados em Tempo de Execução
aplicação/public/uploads/favicons/*
!aplicação/public/uploads/favicons/.gitkeep
